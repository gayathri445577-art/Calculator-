<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Career Recommendation Engine</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
/* BODY AND CONTAINER */
body {
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #e3f2fd, #fce4ec);
  padding: 40px 10px;
  margin: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.container {
  background: white;
  max-width: 500px;
  width: 90%;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

h1, h2 {
  text-align: center;
  color: #333;
}

/* FORM ELEMENTS */
label {
  display: block;
  margin-top: 1rem;
  font-weight: bold;
  color: #555;
}

input, select, button {
  width: 100%;
  padding: 0.8rem;
  margin-top: 0.5rem;
  border-radius: 6px;
  border: 1px solid #ccc;
  box-sizing: border-box;
  font-size: 14px;
}

button {
  background-color: #1976d2;
  color: white;
  border: none;
  font-size: 16px;
  font-weight: bold;
  margin-top: 1.5rem;
  cursor: pointer;
  transition: 0.3s;
}

button:hover {
  background-color: #0d47a1;
}

/* RESULTS SECTION */
.results {
  margin-top: 2rem;
}

.card {
  background: #f1f8ff;
  padding: 15px 20px;
  margin-top: 12px;
  border-left: 5px solid #1976d2;
  border-radius: 6px;
}

.career-title {
  font-weight: bold;
  font-size: 16px;
  color: #0d47a1;
}

.reason {
  margin-top: 5px;
  color: #444;
}

/* FOOTER */
footer {
  text-align: center;
  margin-top: 25px;
  font-size: 13px;
  color: #777;
}

/* RESPONSIVE */
@media (max-width: 700px) {
  .container {
    padding: 20px;
  }

  input, select, button {
    font-size: 14px;
    padding: 10px;
  }
}


    </style>
</head>

<body>
<div class="container">
    <h2>🎓 Career Recommendation Engine</h2>

    <!-- FORM -->
    <form method="POST">
        <label>Education Level</label>
        <select name="education" required>
            <option value="">Select Education</option>
            <option>Intermediate</option>
            <option>Graduate</option>
            <option>Postgraduate</option>
        </select>

        <label>Interests (comma separated)</label>
        <input type="text" name="interests" placeholder="technology, data, design" required>

        <label>Skills (comma separated)</label>
        <input type="text" name="skills" placeholder="python, excel, communication" required>

        <button type="submit">Get Career Suggestions</button>
    </form>

    <!-- RESULTS -->
    {% if results %}
    <div class="results">
        <h3>🔍 Recommended Careers</h3>
        {% for r in results %}
            <div class="card">
                <div class="career-title">{{ r.career }}</div>
                <div class="reason">{{ r.reason }}</div>
            </div>
        {% endfor %}
    </div>
    {% endif %}
</div>

<footer>
    Built as an MVP for Career Guidance | Codeathon Project
</footer>
</body>
</html>